<Window x:Class="ZseAdmin.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZSE-Admin — pracownie, komputery, logowania i akcje"
        Height="800"
        Width="1460"
        MinHeight="620"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.AppBackground}"
        FontFamily="{StaticResource Font.Default}"
        Foreground="{StaticResource Brush.Text}">

    <DockPanel>

        <!-- Pasek nagłówka: tożsamość, świeżość danych, stan połączenia.
             Jasna powierzchnia + 1px linia podziału (bez ciemnego paska, bez poświaty). -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="{StaticResource Line.Bottom}"
                Padding="{StaticResource Padding.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="ZSE-Admin"
                           Style="{StaticResource Text.Title}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding IdentityText}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="{Binding FreshnessText}"
                           Style="{StaticResource Text.Meta}"
                           Foreground="{StaticResource Brush.StatusWarn}"
                           Margin="24,0,16,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="3"
                           Text="{Binding ConnectionStatusText}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Accent}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Pasek dolny: komunikat operacyjny i odświeżanie -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.SurfaceMuted}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="{StaticResource Line.Top}"
                Padding="{StaticResource Padding.Footer}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Odśwież"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding RefreshCommand}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Margin="{StaticResource Padding.Window}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Pracownie -->
            <Border Grid.Column="0" Style="{StaticResource CardSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pracownie" Style="{StaticResource Text.Section}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Nauczyciel widzi tylko pracownie, w których ma teraz zajęcia."
                               Style="{StaticResource Text.Meta}"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Classrooms}"
                             SelectedItem="{Binding SelectedClassroom}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Style="{StaticResource Text.Meta}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Komputery -->
            <Border Grid.Column="2" Style="{StaticResource CardSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Komputery" Style="{StaticResource Text.Section}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Stan i IP to informacja bieżąca lub ostatnio zaobserwowana — kolumna „Ostatni stan” pokazuje kiedy. Wybór wiersza ustawia cel akcji i audytu."
                               Style="{StaticResource Text.Meta}"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Computers}"
                              SelectedItem="{Binding SelectedComputer}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Komputer" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="Stan" Binding="{Binding StatusText}" Width="90" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="110" />
                            <DataGridTextColumn Header="Pracownia" Binding="{Binding ClassroomName}" Width="115" />
                            <DataGridTextColumn Header="Ostatni stan" Binding="{Binding StatusObservedText}" Width="125" />
                            <DataGridTextColumn Header="Ostatnie logowanie" Binding="{Binding LastLogonText}" Width="135" />
                            <DataGridTextColumn Header="System" Binding="{Binding OperatingSystem}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Logowania, akcje i audyt -->
            <Border Grid.Column="4" Style="{StaticResource CardSurface}">
                <TabControl>
                    <TabItem Header="Logowania">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Ostatnie logowania" Style="{StaticResource Text.Section}" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Historia zdarzeń, nie lista aktywnych sesji. Nowe zdarzenia przychodzą z serwera bez odświeżania."
                                       Style="{StaticResource Text.Meta}"
                                       Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding Logins}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}"
                                                       Style="{StaticResource Text.Label}"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource Text.Meta}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Akcje i audyt">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Akcje (wymagają potwierdzenia)" Style="{StaticResource Text.Section}" />

                                <TextBlock Text="Cel operacji: komputer albo konto AD" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ActionTargetText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Grupa AD (tylko „Dodaj do grupy”)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding GroupNameText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Powód (opcjonalnie, trafia do audytu)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ActionReasonText, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,0,0"
                                            Visibility="{Binding CanControlComputers, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Restart stacji" Command="{Binding RestartCommand}" />
                                    <Button Content="Zablokuj ekran" Command="{Binding LockCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,0,0"
                                            Visibility="{Binding CanWriteUsers, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Reset hasła" Command="{Binding ResetPasswordCommand}" />
                                    <Button Content="Dodaj do grupy" Command="{Binding AddToGroupCommand}" />
                                </StackPanel>

                                <TextBlock Text="Akcje są widoczne tylko wtedy, gdy rola ma odpowiednie uprawnienie."
                                           Style="{StaticResource Text.Meta}"
                                           Margin="0,8,0,8" />

                                <Border Style="{StaticResource Card.Warning}"
                                        Margin="0,4,0,8"
                                        Visibility="{Binding CanConfirmAction, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PendingActionText}"
                                                   Style="{StaticResource Text.Body}"
                                                   Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Potwierdź"
                                                    Style="{StaticResource Button.Primary}"
                                                    Command="{Binding ConfirmActionCommand}" />
                                            <Button Content="Anuluj" Command="{Binding CancelActionCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding TemporaryPasswordText}"
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.StatusWarn}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <Border Style="{StaticResource SectionSeparator}" Margin="0,8" />

                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Odśwież audyt"
                                            Command="{Binding RefreshAuditCommand}"
                                            Visibility="{Binding CanReadAudit, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Audyt operacji" Style="{StaticResource Text.Section}" />
                                </DockPanel>

                                <TextBlock Text="{Binding AuditSummaryText}" Style="{StaticResource Text.Meta}" Margin="0,0,0,6" />

                                <ListBox ItemsSource="{Binding AuditItems}"
                                         MinHeight="120"
                                         MaxHeight="220"
                                         Visibility="{Binding CanReadAudit, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Headline}"
                                                           Style="{StaticResource Text.Label}"
                                                           Foreground="{StaticResource Brush.Text}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource Text.Meta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>
    </DockPanel>
</Window>
