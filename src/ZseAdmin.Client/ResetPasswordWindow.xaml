<Window x:Class="ZseAdmin.Client.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZSE-Admin — reset hasła"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="Nowe hasło" FontSize="11" Foreground="#374151" />
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10" />
        <TextBlock Text="Powtórz hasło" FontSize="11" Foreground="#374151" />
        <PasswordBox x:Name="ConfirmBox" Margin="0,4,0,10" />
        <TextBlock x:Name="ValidationText" Foreground="#B91C1C" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Resetuj hasło" Width="120" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
