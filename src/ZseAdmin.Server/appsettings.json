{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ZseAdmin": {
    "Environment": "Development",
    "UseMockData": true,
    "UseMockDataForLogins": false,
    "StatusPollSeconds": 15,
    "Classrooms": {
      "Path": "classrooms.json"
    },
    "Directory": {
      "Host": "zse-dc01.zse.local",
      "Domain": "zse.local",
      "Port": 389,
      "UseSsl": false,
      "SearchBase": "DC=zse,DC=local",
      "PageSize": 500,
      "MaxComputers": 2000,
      "CacheSeconds": 60
    },
    "StatusProbe": {
      "Enabled": true,
      "TimeoutMilliseconds": 1000,
      "MaxParallelism": 32
    },
    "Freshness": {
      "ComputersSeconds": 120,
      "LoginsSeconds": 900,
      "DirectorySeconds": 3600,
      "AuditSeconds": 3600
    },
    "LoginHistory": {
      "Enabled": true,
      "Source": "WindowsEventLog",
      "PollSeconds": 60,
      "RetentionDays": 30,
      "MaxEvents": 20000,
      "LookbackMinutes": 120,
      "OverlapMinutes": 5,
      "WefDirectory": "wef"
    },
    "Audit": {
      "RetentionMonths": 12,
      "FilePath": null
    },
    "Actions": {
      "ConfirmationSeconds": 120,
      "RestartDelaySeconds": 30,
      "AllowWrites": true
    }
  },
  "Security": {
    "Mode": "Token",
    "RequireSecureTransport": false,
    "RequireToken": true,
    "Tokens": [
      {
        "Name": "dev-admin",
        "Token": "dev-admin-token",
        "Role": "Administrator"
      },
      {
        "Name": "dev-teacher",
        "Token": "dev-teacher-token",
        "Role": "Teacher"
      }
    ],
    "DeniedGroups": [
      "ZSE-Uczniowie"
    ],
    "RoleGroups": {
      "ZSE-Admin-Administratorzy": "Administrator",
      "ZSE-Admin-Nauczyciele": "Teacher",
      "ZSE-Admin-ReadOnly": "ReadOnly"
    },
    "TeacherClassrooms": {
      "dev-teacher": ["prac-101", "prac-102"],
      "k.mazur": ["prac-101"]
    },
    "TeachingSlots": [],
    "EnforceTeacherClassroomScope": true
  }
}
