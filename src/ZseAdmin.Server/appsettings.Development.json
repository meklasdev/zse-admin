{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ZseAdmin": {
    "Environment": "Development",
    "UseMockData": true,
    "UseMockDataForLogins": true,
    "StatusPollSeconds": 10
  },
  "Security": {
    "Authentication": {
      "Mode": "DevelopmentTokens"
    },
    "RequireSecureTransport": false,
    "Tokens": [
      {
        "Name": "dev-admin",
        "Token": "dev-admin-token",
        "Role": "Administrator"
      },
      {
        "Name": "dev-teacher",
        "Token": "dev-teacher-token",
        "Role": "Teacher"
      }
    ]
  }
}
