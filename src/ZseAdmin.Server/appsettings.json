{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ZseAdmin": {
    "Environment": "Development",
    "UseMockData": true,
    "UseMockDataForLogins": true,
    "StatusPollSeconds": 15,
    "Classrooms": {
      "Path": "classrooms.json"
    },
    "Directory": {
      "Host": "zse-dc01.zse.local",
      "Domain": "zse.local",
      "Port": 389,
      "UseSsl": false,
      "SearchBase": "DC=zse,DC=local",
      "PageSize": 500,
      "MaxComputers": 2000,
      "CacheSeconds": 60
    },
    "StatusProbe": {
      "Enabled": true,
      "TimeoutMilliseconds": 1000,
      "MaxParallelism": 32
    },
    "Freshness": {
      "ComputersSeconds": 120,
      "LoginsSeconds": 900,
      "DirectorySeconds": 3600
    }
  },
  "Security": {
    "RequireToken": true,
    "Tokens": [
      {
        "Name": "dev-admin",
        "Token": "dev-admin-token",
        "Role": "Administrator"
      },
      {
        "Name": "dev-teacher",
        "Token": "dev-teacher-token",
        "Role": "Teacher"
      }
    ]
  }
}
