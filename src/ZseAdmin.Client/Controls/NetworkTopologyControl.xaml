<UserControl x:Class="ZseAdmin.Client.Controls.NetworkTopologyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardSurface}" Padding="12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Topologia pracowni" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Połączenia są poglądowe. Wybierz stanowisko, aby ustawić je jako cel operacji."
                           Style="{StaticResource Text.Meta}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="● Online" Foreground="{StaticResource Brush.StatusOk}" Style="{StaticResource Text.Meta}" Margin="0,0,16,0" />
                    <TextBlock Text="● Offline" Foreground="{StaticResource Brush.StatusError}" Style="{StaticResource Text.Meta}" Margin="0,0,16,0" />
                    <TextBlock Text="● Brak danych" Foreground="{StaticResource Brush.StatusWarn}" Style="{StaticResource Text.Meta}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="DiagramCanvas" Width="960" Height="360"
                        Background="{StaticResource Brush.Surface}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
