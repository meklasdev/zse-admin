<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ZAD-01 — jedyne źródło wartości wizualnych (docs/ui-design-system.md §2).
        Zasada „zero glow": płaskie powierzchnie, obramowania 1px, brak cieni,
        gradientów i efektów. Widoki nie mogą zawierać własnych kolorów — tylko
        StaticResource z tego pliku.
    -->

    <!-- ============================ Kolory ============================ -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#F1F3F5" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DDE1E6" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#B8BEC7" />
    <SolidColorBrush x:Key="Brush.Text" Color="#111827" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5B6472" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1E40AF" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#EEF2FF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.StatusOk" Color="#15803D" />
    <SolidColorBrush x:Key="Brush.StatusWarn" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.StatusError" Color="#B91C1C" />
    <SolidColorBrush x:Key="Brush.StatusInfo" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#9AA1AC" />

    <!-- Brak koloru = przezroczystość; osobny token, żeby widoki nie pisały „Transparent". -->
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <!-- ========================== Geometria ========================== -->
    <Thickness x:Key="Border1">1</Thickness>
    <Thickness x:Key="BorderNone">0</Thickness>
    <Thickness x:Key="Line.Bottom">0,0,0,1</Thickness>
    <Thickness x:Key="Line.Top">0,1,0,0</Thickness>

    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Surface">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Te same promienie jako liczby: potrzebne tam, gdzie WPF przyjmuje double (np. Rectangle). -->
    <sys:Double x:Key="Radius.Control.Value">6</sys:Double>
    <sys:Double x:Key="Radius.Surface.Value">8</sys:Double>

    <!-- Wyłącznie przerywane strefy upuszczania plików (ZAD-03/ZAD-08). -->
    <DoubleCollection x:Key="Stroke.Dash">4 3</DoubleCollection>

    <!-- ========================== Odstępy =========================== -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">24</sys:Double>
    <sys:Double x:Key="Space.6">32</sys:Double>

    <Thickness x:Key="Padding.Window">12</Thickness>
    <Thickness x:Key="Padding.Header">16,12</Thickness>
    <Thickness x:Key="Padding.Footer">16,8</Thickness>
    <Thickness x:Key="Padding.Card">12</Thickness>
    <Thickness x:Key="Padding.Field">10,8</Thickness>
    <Thickness x:Key="Padding.Button">14,6</Thickness>
    <Thickness x:Key="Padding.Pill">8,2</Thickness>

    <sys:Double x:Key="Size.FormLabel">260</sys:Double>
    <sys:Double x:Key="Size.RowMinHeight">40</sys:Double>
    <sys:Double x:Key="Size.Icon.Small">16</sys:Double>
    <sys:Double x:Key="Size.Icon.Medium">20</sys:Double>
    <sys:Double x:Key="Size.Icon.Large">24</sys:Double>

    <!-- ========================= Typografia ========================= -->
    <!-- D9 = A: krój systemowy, bez dołączania plików fontu (brak decyzji licencyjnej). -->
    <FontFamily x:Key="Font.Default">Segoe UI</FontFamily>

    <sys:Double x:Key="Font.Size.Title">20</sys:Double>
    <sys:Double x:Key="Font.Size.Section">14</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Label">12</sys:Double>
    <sys:Double x:Key="Font.Size.Meta">11</sys:Double>

    <!--
        Bazowy styl tekstu ustawia tylko krój i rozmiar. Koloru celowo tu nie ma:
        TextBlock generowany przez ContentPresenter (np. treść przycisku) musi
        dziedziczyć Foreground od kontrolki — inaczej przycisk pierwotny straciłby
        kontrast tekstu na tle akcentu.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Meta}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
