<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ZseAdmin.Server</RootNamespace>
    <AssemblyName>ZseAdmin.Server</AssemblyName>
    <Version>0.1.0</Version>
    <UserSecretsId>zse-admin-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZseAdmin.Contracts\ZseAdmin.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adapter LDAP (etap M1). Pakiet dostarcza System.DirectoryServices.Protocols na każdą platformę. -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
    <!-- M2: EventLogReader/EventLogQuery do zdalnego odczytu dziennika Security (Windows). -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <!-- M3: Negotiate/Kerberos dla Kestrel (IIS/HTTP.sys dostarczają WindowsIdentity samodzielnie). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZseAdminClientBundle)' == 'true'">
    <!-- Klient demo wymusza własną konfigurację mocków; nie kopiuj ustawień serwera
         obok appsettings.json klienta ani do pakietu jednego EXE. -->
    <Content Remove="@(Content)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Definicja pracowni jest konfiguracją, nie kodem: plik trafia do katalogu publikacji. -->
    <None Update="classrooms.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Bramka produkcyjna M3 musi być obecna także po publish. -->
    <Content Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
