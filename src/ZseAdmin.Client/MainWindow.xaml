<Window x:Class="ZseAdmin.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZSE-Admin — pracownie, komputery, logowania"
        Height="780"
        Width="1320"
        MinHeight="600"
        MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <DockPanel>

        <!-- Pasek nagłówka: tożsamość, świeżość danych, stan połączenia -->
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="ZSE-Admin"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding FreshnessText}"
                           Foreground="#FCD34D"
                           FontSize="12"
                           Margin="24,0,16,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           Text="{Binding ConnectionStatusText}"
                           Foreground="#93C5FD"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Pasek dolny: komunikat operacyjny i odświeżanie -->
        <Border DockPanel.Dock="Bottom" Background="#E5E7EB" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Odśwież"
                        Command="{Binding RefreshCommand}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#374151"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Pracownie -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pracownie" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Classrooms}"
                             SelectedItem="{Binding SelectedClassroom}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Komputery -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Komputery" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Stan i IP to informacja bieżąca lub ostatnio zaobserwowana — kolumna „Ostatni stan” pokazuje kiedy."
                               Foreground="#6B7280"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Computers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeight="26"
                              AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Komputer" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="Stan" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="115" />
                            <DataGridTextColumn Header="Pracownia" Binding="{Binding ClassroomName}" Width="120" />
                            <DataGridTextColumn Header="Ostatni stan" Binding="{Binding StatusObservedText}" Width="130" />
                            <DataGridTextColumn Header="Ostatnie logowanie" Binding="{Binding LastLogonText}" Width="140" />
                            <DataGridTextColumn Header="System" Binding="{Binding OperatingSystem}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Logowania -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ostatnie logowania" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Historia zdarzeń, nie lista aktywnych sesji."
                               Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Logins}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
