{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ZseAdmin": {
    "Environment": "Development",
    "UseMockData": true,
    "StatusPollSeconds": 15,
    "Freshness": {
      "ComputersSeconds": 120,
      "LoginsSeconds": 900,
      "DirectorySeconds": 3600
    }
  },
  "Security": {
    "RequireToken": true,
    "Tokens": [
      {
        "Name": "dev-admin",
        "Token": "dev-admin-token",
        "Role": "Administrator"
      },
      {
        "Name": "dev-teacher",
        "Token": "dev-teacher-token",
        "Role": "Teacher"
      }
    ]
  }
}
