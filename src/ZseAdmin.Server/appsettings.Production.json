{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ZseAdmin": {
    "Environment": "Production",
    "UseMockData": false,
    "UseMockDataForLogins": false,
    "StatusPollSeconds": 15,
    "Classrooms": {
      "Path": "classrooms.json"
    },
    "Directory": {
      "Host": "zse-dc01.zse.local",
      "Domain": "zse.local",
      "Port": 636,
      "UseSsl": true,
      "SearchBase": "DC=zse,DC=local",
      "PageSize": 500,
      "MaxComputers": 2000,
      "CacheSeconds": 60
    },
    "StatusProbe": {
      "Enabled": true,
      "TimeoutMilliseconds": 1000,
      "MaxParallelism": 32,
      "BudgetMilliseconds": 8000
    },
    "Freshness": {
      "ComputersSeconds": 120,
      "LoginsSeconds": 900,
      "DirectorySeconds": 3600
    },
    "Data": {
      "Directory": "data"
    },
    "Logins": {
      "PollSeconds": 60,
      "RetentionDays": 30,
      "StationAccessBudgetSeconds": 30
    },
    "Actions": {
      "PsExecPath": "C:\\Tools\\PsExec64.exe",
      "ShutdownTimeoutSeconds": 15
    },
    "Audit": {
      "RetentionMonths": 12
    }
  },
  "Security": {
    "Authentication": {
      "Mode": "ActiveDirectory"
    },
    "GroupMapping": {
      "AdministratorGroup": "ZSE-Admin-Administratorzy",
      "TeacherGroup": "ZSE-Admin-Nauczyciele",
      "ReadOnlyGroup": "ZSE-Admin-Podglad"
    },
    "RequireSecureTransport": true,
    "TrustForwardedHeaders": true,
    "Tokens": []
  }
}
