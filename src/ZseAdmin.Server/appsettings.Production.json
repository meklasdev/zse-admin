{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ZseAdmin": {
    "Environment": "Production",
    "UseMockData": false,
    "UseMockDataForLogins": false,
    "StatusPollSeconds": 15,
    "Classrooms": {
      "Path": "classrooms.json"
    },
    "Directory": {
      "Port": 636,
      "UseSsl": true
    },
    "LoginHistory": {
      "Enabled": true,
      "Source": "WindowsEventLog",
      "PollSeconds": 60,
      "RetentionDays": 30
    },
    "Audit": {
      "RetentionMonths": 12,
      "FilePath": "C:\\ProgramData\\ZseAdmin\\audit.jsonl"
    },
    "Actions": {
      "AllowWrites": true
    }
  },
  "Security": {
    "Mode": "Windows",
    "RequireSecureTransport": true,
    "RequireToken": true,
    "Tokens": [],
    "DeniedGroups": [
      "ZSE-Uczniowie"
    ],
    "RoleGroups": {
      "ZSE-Admin-Administratorzy": "Administrator",
      "ZSE-Admin-Nauczyciele": "Teacher",
      "ZSE-Admin-ReadOnly": "ReadOnly"
    },
    "TeacherClassrooms": {
      "dev-teacher": [],
      "k.mazur": []
    },
    "TeachingSlots": [],
    "EnforceTeacherClassroomScope": true
  }
}
